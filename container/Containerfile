# syntax=docker/dockerfile:1
# The bridge for hosts without a usable native Soloist audio path (macOS and Windows, whose Soloist
# plays only to the system's default output) and for Linux hosts that prefer a container. Soloist
# runs from Spotify's Linux build, fetched into the data volume at start, never baked in (its
# terms forbid redistribution), and plays into a private PulseAudio null sink, not the host's audio.
# Multi-arch: linux/amd64, linux/arm64, linux/arm/v7.
FROM debian:trixie-slim

# libatomic1: linked by Soloist; libpulse0 and ffmpeg's libraries: dlopened by it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl ffmpeg libatomic1 pulseaudio pulseaudio-utils \
        python3 python3-aiohttp python3-cryptography python3-pip python3-setuptools python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 soloify \
    && install -d -o soloify -g soloify /data /run/soloify

COPY pyproject.toml /src/
COPY bridge /src/bridge
RUN python3 -m venv --system-site-packages /opt/soloify \
    && /opt/soloify/bin/pip install --no-deps --no-build-isolation --no-cache-dir /src \
    && rm -rf /src

COPY tools/soloist-fetch tools/soloist-run tools/soloify-sink /usr/local/bin/
COPY container/pulse.pa /etc/soloify/pulse.pa
COPY container/entrypoint /usr/local/bin/soloify-entrypoint

ENV PATH=/opt/soloify/bin:/data/soloist:$PATH \
    XDG_RUNTIME_DIR=/run/soloify \
    SOLOIFY_DATA=/data \
    SOLOIST_API_KEY_FILE=/run/soloify/api.key

VOLUME /data
EXPOSE 7443
ENTRYPOINT ["soloify-entrypoint"]
CMD ["soloify", "serve"]
